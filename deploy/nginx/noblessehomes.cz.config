# HTTP -> HTTPS, www -> non-www
server {
    listen 80;
    listen [::]:80;
    server_name noblessehomes.cz www.noblessehomes.cz;

    return 301 https://noblessehomes.cz$request_uri;
}

# HTTPS www -> non-www
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.noblessehomes.cz;

    ssl_certificate     /etc/letsencrypt/live/noblessehomes.cz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/noblessehomes.cz/privkey.pem;

    return 301 https://noblessehomes.cz$request_uri;
}

# Основной сайт: HTTPS без www -> Next.js на 3002
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name noblessehomes.cz;

    ssl_certificate     /etc/letsencrypt/live/noblessehomes.cz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/noblessehomes.cz/privkey.pem;

    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    location / {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_redirect off;
    }
}